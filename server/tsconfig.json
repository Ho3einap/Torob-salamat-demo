{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2021",
    "declaration": false,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "sourceMap": false,
    "outDir": "../dist/server",
    "rootDir": "src",
    "incremental": false,
    "strict": false,
    "skipLibCheck": true,
    "lib": ["es2021"],
    "types": ["node"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "../node_modules"]
}
